{
  "manifest_version": 3,
  "name": "SafePrompt",
  "version": "0.1.0",
  "description": "Detects sensitive information before it is shared with AI tools.",

  "icons": {
    "128": "logo.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["styles.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "wasm/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}